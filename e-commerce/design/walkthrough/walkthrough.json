 "scenarios": [
  {
   "id": "tour",
   "title": "Architecture tour",
   "summary": "Edge, web, API, services, events, stores",
   "steps": [
    {
     "say": "Every request enters through the NGINX edge: TLS ends here, each address is rate-limited, and public assets are cached.",
     "active": [
      "cust",
      "edge"
     ],
     "packets": [
      {
       "from": "cust",
       "to": "edge",
       "label": "HTTPS",
       "kind": "req"
      }
     ]
    },
    {
     "say": "Pages come from the storefront, which renders on the server and keeps the user's tokens in its own session store. Sign-in goes to Keycloak.",
     "active": [
      "edge",
      "sf",
      "kc"
     ],
     "packets": [
      {
       "from": "edge",
       "to": "sf",
       "label": "pages",
       "kind": "req"
      },
      {
       "from": "edge",
       "to": "kc",
       "label": "sign-in",
       "kind": "req"
      }
     ]
    },
    {
     "say": "API calls go through api-gateway: it validates the JWT, applies rate limits per user and per address, and protects hot products with admission control.",
     "active": [
      "sf",
      "gw"
     ],
     "packets": [
      {
       "from": "sf",
       "to": "gw",
       "label": "/api/v1/…",
       "kind": "req"
      }
     ]
    },
    {
     "say": "Behind it, eleven services each own one part of the shop and their own data. None shares a database or a line of code with another.",
     "active": [
      "cat",
      "srch",
      "cart",
      "rev",
      "ord",
      "inv",
      "pay",
      "notif",
      "ana",
      "reco"
     ]
    },
    {
     "say": "Only checkout calls other services synchronously: order-service runs the saga across cart, inventory and payment. Everything else learns about changes from events.",
     "active": [
      "ord",
      "cart",
      "inv",
      "pay"
     ],
     "packets": [
      {
       "from": "ord",
       "to": "inv",
       "label": "reserve",
       "kind": "req"
      },
      {
       "from": "ord",
       "to": "pay",
       "label": "authorise",
       "kind": "req"
      }
     ]
    },
    {
     "say": "Events go through Kafka, written first to an outbox table in the same transaction as the change, so an event is published if and only if the change committed.",
     "active": [
      "ord",
      "cat",
      "inv",
      "kafka"
     ],
     "packets": [
      {
       "from": "ord",
       "to": "kafka",
       "label": "order.events",
       "kind": "event"
      },
      {
       "from": "cat",
       "to": "kafka",
       "label": "catalog.events",
       "kind": "event"
      }
     ]
    },
    {
     "say": "Each store fits its job: PostgreSQL for orders, stock, payments and the catalogue; Redis for carts and caches; OpenSearch for search; Cassandra for reviews; ClickHouse for analytics.",
     "active": [
      "pg",
      "redis",
      "os",
      "rev",
      "ana"
     ],
     "ok": [
      "pg",
      "redis",
      "os"
     ]
    }
   ]
  },
  {
   "id": "browse",
   "title": "Browse and search",
   "summary": "Cached product pages, search from a read model",
   "steps": [
    {
     "say": "Ada opens a product page. The edge serves anonymous public pages from its cache when it can.",
     "active": [
      "cust",
      "edge"
     ],
     "packets": [
      {
       "from": "cust",
       "to": "edge",
       "label": "GET /products/trail-shoe",
       "kind": "req"
      }
     ]
    },
    {
     "say": "On a miss the storefront asks the API for the product. catalog-service looks in Redis first: a cache hit never touches PostgreSQL.",
     "active": [
      "sf",
      "gw",
      "cat",
      "redis"
     ],
     "packets": [
      {
       "from": "sf",
       "to": "gw",
       "label": "GET /api/v1/products/id",
       "kind": "req"
      },
      {
       "from": "gw",
       "to": "cat",
       "label": "GET",
       "kind": "req"
      },
      {
       "from": "cat",
       "to": "redis",
       "label": "GET product:id",
       "kind": "req"
      }
     ]
    },
    {
     "say": "On a cache miss it reads PostgreSQL and stores the result in Redis for 10 minutes.",
     "active": [
      "cat",
      "pg",
      "redis"
     ],
     "packets": [
      {
       "from": "cat",
       "to": "pg",
       "label": "SELECT product",
       "kind": "req"
      },
      {
       "from": "cat",
       "to": "redis",
       "label": "SET 10 min",
       "kind": "req"
      }
     ]
    },
    {
     "say": "Ada searches for trail shoes. search-service answers from OpenSearch, a read model shaped for search: full text, filters by brand and price, facets and cursor pages.",
     "active": [
      "gw",
      "srch",
      "os"
     ],
     "packets": [
      {
       "from": "gw",
       "to": "srch",
       "label": "GET /api/v1/search?q=trail",
       "kind": "req"
      },
      {
       "from": "srch",
       "to": "os",
       "label": "query",
       "kind": "req"
      }
     ]
    },
    {
     "say": "Both answers come back well inside their budgets: 150 ms for a product page, 300 ms for a search, at the 99th percentile.",
     "active": [
      "cust"
     ],
     "packets": [
      {
       "from": "gw",
       "to": "sf",
       "label": "200 OK",
       "kind": "res"
      },
      {
       "from": "sf",
       "to": "cust",
       "label": "page",
       "kind": "res"
      }
     ],
     "ok": [
      "cat",
      "srch"
     ]
    }
   ]
  },
  {
   "id": "cart",
   "title": "Add to cart",
   "summary": "Guest cart, prices from catalog, merge at sign-in",
   "steps": [
    {
     "say": "Ada is not signed in yet. The storefront gives her a random guest cookie and sends it to the API as a guest id.",
     "active": [
      "cust",
      "sf"
     ],
     "packets": [
      {
       "from": "cust",
       "to": "sf",
       "label": "Add to cart",
       "kind": "req"
      }
     ]
    },
    {
     "say": "The gateway checks the per-SKU admission limit, then cart-service adds the line to her cart in Redis.",
     "active": [
      "gw",
      "cart",
      "redis"
     ],
     "packets": [
      {
       "from": "sf",
       "to": "gw",
       "label": "PUT /api/v1/cart/items/sku",
       "kind": "req"
      },
      {
       "from": "gw",
       "to": "cart",
       "label": "PUT",
       "kind": "req"
      },
      {
       "from": "cart",
       "to": "redis",
       "label": "HSET cart:guest",
       "kind": "req"
      }
     ]
    },
    {
     "say": "To show the cart, cart-service fetches current prices from catalog-service for the SKUs it has not cached in the last 30 seconds.",
     "active": [
      "cart",
      "cat"
     ],
     "packets": [
      {
       "from": "cart",
       "to": "cat",
       "label": "prices by SKU",
       "kind": "req"
      }
     ]
    },
    {
     "say": "Ada signs in through Keycloak. The storefront starts a new session and merges the guest cart into her account's cart, then clears the guest cookie.",
     "active": [
      "sf",
      "kc",
      "cart"
     ],
     "packets": [
      {
       "from": "sf",
       "to": "kc",
       "label": "code + PKCE",
       "kind": "req"
      },
      {
       "from": "sf",
       "to": "gw",
       "label": "POST /api/v1/cart/merge",
       "kind": "req"
      }
     ],
     "ok": [
      "cart"
     ]
    }
   ]
  },
  {
   "id": "checkout",
   "title": "Checkout that succeeds",
   "summary": "Reserve, authorise, commit, capture, confirm",
   "steps": [
    {
     "say": "Ada presses Place order. The storefront adds the idempotency key it created when the checkout page opened, and her access token from the server-side session. The browser never sees the token.",
     "active": [
      "cust",
      "edge",
      "sf"
     ],
     "packets": [
      {
       "from": "cust",
       "to": "edge",
       "label": "POST /checkout",
       "kind": "req"
      },
      {
       "from": "edge",
       "to": "sf",
       "label": "POST /checkout",
       "kind": "req"
      }
     ]
    },
    {
     "say": "The gateway checks the token's signature, issuer and audience, applies her per-user checkout limit, and routes to order-service.",
     "active": [
      "sf",
      "gw",
      "ord"
     ],
     "packets": [
      {
       "from": "sf",
       "to": "gw",
       "label": "POST /api/v1/orders · key",
       "kind": "req"
      },
      {
       "from": "gw",
       "to": "ord",
       "label": "place order",
       "kind": "req"
      }
     ]
    },
    {
     "say": "order-service stores the key and a PENDING order in one transaction, then asks cart-service for a snapshot of the cart with prices. It never trusts prices sent by a client.",
     "active": [
      "ord",
      "pg",
      "cart"
     ],
     "packets": [
      {
       "from": "ord",
       "to": "pg",
       "label": "INSERT order PENDING",
       "kind": "req"
      },
      {
       "from": "ord",
       "to": "cart",
       "label": "GET checkout-snapshot",
       "kind": "req"
      }
     ]
    },
    {
     "say": "inventory-service reserves the stock with one conditional update per line, so two buyers can never take the last pair.",
     "active": [
      "ord",
      "inv",
      "pg"
     ],
     "packets": [
      {
       "from": "ord",
       "to": "inv",
       "label": "POST /internal/reservations",
       "kind": "req"
      },
      {
       "from": "inv",
       "to": "pg",
       "label": "UPDATE … WHERE available >= qty",
       "kind": "req"
      }
     ],
     "badges": [
      {
       "node": "inv",
       "text": "reserved",
       "tone": "ok"
      }
     ]
    },
    {
     "say": "payment-service asks the provider to authorise the card token. The platform never sees a card number.",
     "active": [
      "ord",
      "pay",
      "psp"
     ],
     "packets": [
      {
       "from": "ord",
       "to": "pay",
       "label": "authorise",
       "kind": "req"
      },
      {
       "from": "pay",
       "to": "psp",
       "label": "authorise token",
       "kind": "req"
      }
     ],
     "badges": [
      {
       "node": "pay",
       "text": "authorised",
       "tone": "ok"
      }
     ]
    },
    {
     "say": "order-service commits the reservation and captures the payment. Each step is saved before the next, so a crash resumes where it stopped.",
     "active": [
      "ord",
      "inv",
      "pay"
     ],
     "packets": [
      {
       "from": "ord",
       "to": "inv",
       "label": "commit",
       "kind": "req"
      },
      {
       "from": "ord",
       "to": "pay",
       "label": "capture",
       "kind": "req"
      }
     ]
    },
    {
     "say": "The order becomes CONFIRMED, and an OrderConfirmed event is written to the outbox in the same transaction.",
     "active": [
      "ord",
      "pg"
     ],
     "packets": [
      {
       "from": "ord",
       "to": "pg",
       "label": "UPDATE CONFIRMED + outbox",
       "kind": "req"
      }
     ],
     "ok": [
      "ord"
     ]
    },
    {
     "say": "Ada gets 201 Created. A double-click or retry with the same key returns this same order and calls nothing again.",
     "active": [
      "cust"
     ],
     "packets": [
      {
       "from": "ord",
       "to": "gw",
       "label": "201 Created",
       "kind": "res"
      },
      {
       "from": "sf",
       "to": "cust",
       "label": "Order placed",
       "kind": "res"
      }
     ],
     "ok": [
      "ord",
      "inv",
      "pay"
     ]
    }
   ]
  },
