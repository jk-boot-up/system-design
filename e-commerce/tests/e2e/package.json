  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "cassandra-driver": "4.10.0",
    "typescript": "5.9.3"
  }
}
