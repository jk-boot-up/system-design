erDiagram
    ORDERS ||--|{ ORDER_LINES : contains
    IDEMPOTENCY_KEYS ||--|| ORDERS : "points to"
    ORDERS {
        uuid id PK
        timestamptz created_at PK "partition key = UUIDv7 time"
        uuid customer_id
        text customer_email
        text status
        text saga_step
        text cancel_reason
        numeric total_amount
        char currency
        bigint version
        timestamptz updated_at
    }
    ORDER_LINES {
        uuid order_id PK
        timestamptz order_created_at PK
        int line_no PK
        text sku
        text product_name
        int quantity
        numeric unit_price
    }
    IDEMPOTENCY_KEYS {
        uuid customer_id PK
        text idempotency_key PK
        uuid order_id
    }
