        CS[CassandraReviewStore<br/>prepared statements · LWT]
        SI[SchemaInitializer]
    end
    RC & OCL --> RS
    RS --> dom
    RS --> ST & PL & EV
    ST -.-> CS
    PL -.-> CS
    EV -.-> KRE
