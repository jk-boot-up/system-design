upstream gateway {
    server ${GATEWAY_UPSTREAM};
    keepalive 64;
}

# A coarse first line per address (ADDRESS_RATE: 50r/s by default); fine-grained limits (per user, per SKU) are the
# gateway's job.
limit_req_zone $binary_remote_addr zone=per_address:20m rate=${ADDRESS_RATE};

# Sign-in, callback and sign-out per address (SIGN_IN_RATE: 10r/m by default; the local stack allows more for the tests).
limit_req_zone $binary_remote_addr zone=sign_in:10m rate=${SIGN_IN_RATE};

upstream storefront {
    server ${STOREFRONT_UPSTREAM};
    keepalive 32;
}

# Pages may come from the cache only for visitors without a session or cart cookie: anything personal is never shared.
map $http_cookie $shop_cookie {
    default                           0;
    "~(^|;\s*)__Host-(sid|guest)="    1;
}

server {
    listen 8080;
    location = /healthz { access_log off; return 200 "ok\n"; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 8443 ssl;
    http2 on;
    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:tls:10m;

    include /etc/nginx/security-headers.conf;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-Id $req_id;
    proxy_hide_header X-Request-Id;          # the gateway echoes the same id; NGINX adds it once itself
    proxy_read_timeout 20s;

    location = /healthz { access_log off; return 200 "ok\n"; }

    # Service-to-service APIs are never exposed, whatever the gateway's routes say.
    location /internal { return 404; }

    # Micro-cache: anonymous GETs of product pages, categories and search results are kept for 5 seconds. Under a
    # spike, thousands of identical requests per second become one request every 5 s per URL. Signed-in requests
    # (Authorization header) are never cached or served from the cache.
    location ~ ^/api/v1/(products|categories|search) {
        limit_req zone=per_address burst=100 nodelay;
        proxy_cache micro;
        proxy_cache_methods GET HEAD;
        proxy_cache_key $scheme$request_method$host$request_uri;
        proxy_cache_valid 200 5s;
        proxy_cache_valid 404 1s;
        proxy_cache_lock on;                                  # one request fills a missing entry; the rest wait for it
        proxy_cache_use_stale updating error timeout http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_bypass $http_authorization;
        proxy_no_cache $http_authorization;
        include /etc/nginx/security-headers.conf;
        add_header X-Cache $upstream_cache_status always;
        proxy_pass http://gateway;
    }

    location /api/ {
        limit_req zone=per_address burst=100 nodelay;
        proxy_pass http://gateway;
    }

    # The generated HTML documentation of the whole system (mounted read-only).
    location /docs/ {
        alias /usr/share/nginx/docs/;
        index README.html;
        expires 5m;
    }

    # ── storefront (design/16 §16.12) ────────────────────────────────────────────────────────────────────────────────
    # Its probes and metrics are for the cluster only.
    location ~ ^/(healthz|readyz|metrics)$ { return 404; }

    # Hashed build files: cached here and in browsers for a year.
    location /assets/ {
        proxy_cache micro;
        proxy_cache_valid 200 1h;
        proxy_cache_key $scheme$host$request_uri;
        add_header X-Cache $upstream_cache_status always;
        include /etc/nginx/storefront-proxy.conf;
    }

    # Sign-in endpoints: a tight per-address limit against credential stuffing and session-store flooding.
    location ~ ^/(login|logout|auth/) {
        limit_req zone=sign_in burst=10 nodelay;
        include /etc/nginx/storefront-proxy.conf;
    }

    # Staff pages accept product images (up to 5 MB) and are never cached.
    location /staff {
        client_max_body_size 6m;
        include /etc/nginx/storefront-proxy.conf;
    }

    # Every other path is a storefront page. Responses the storefront marks shareable (X-Accel-Expires: the loader data
    # of public pages, 30 s) are kept for visitors without a session or cart cookie. HTML documents never are: each
    # carries a one-time CSP nonce. Signed-in responses and anything that sets a cookie are never cached.
    location / {
        limit_req zone=per_address burst=100 nodelay;
        proxy_cache micro;
        proxy_cache_methods GET HEAD;
        proxy_cache_key $scheme$request_method$host$request_uri;
        proxy_cache_lock on;
        proxy_cache_use_stale updating error timeout http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_bypass $shop_cookie;
        proxy_no_cache $shop_cookie;
        add_header X-Cache $upstream_cache_status always;
        include /etc/nginx/storefront-proxy.conf;
    }
}
