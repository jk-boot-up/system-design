{
  "name": "storefront",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "api:types": "node scripts/api-types.ts",
    "dev": "node --env-file-if-exists=.env server.ts",
    "build": "react-router build",
    "start": "NODE_ENV=production node server.ts",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node scripts/check-budget.ts",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cdx.json"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.0",
    "@opentelemetry/core": "3.1.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.0",
    "@opentelemetry/instrumentation-http": "0.301.0",
    "@opentelemetry/instrumentation-undici": "0.35.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "@prometheus-io/client": "0.16.1",
    "@react-router/express": "8.5.2",
    "@react-router/node": "8.5.2",
    "compression": "1.8.2",
    "express": "5.3.0",
    "isbot": "5.2.3",
    "jose": "6.2.18",
    "openapi-fetch": "0.17.0",
    "openid-client": "6.9.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "redis": "6.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.2",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
