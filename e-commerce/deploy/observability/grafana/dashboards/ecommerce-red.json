{
  "uid": "ecommerce-red",
  "title": "Services: rate, errors, duration",
  "description": "RED metrics per service and endpoint (Micrometer http.server.requests).",
  "tags": [
    "e-commerce"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_requests_seconds_count, service)",
          "refId": "v"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "links": [
    {
      "title": "E-commerce dashboards",
      "type": "dashboards",
      "tags": [
        "e-commerce"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second by endpoint",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{service=\"$service\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}",
          "datasource": {
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Responses per second by status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{service=\"$service\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "Errors",
      "collapsed": false,
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Server error ratio (5xx)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"$service\", uri!~\"/actuator.*\", outcome=\"SERVER_ERROR\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{service=\"$service\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "datasource": {
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.001,
                "color": "orange"
              },
              {
                "value": 0.01,
                "color": "red"
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Client errors by status (4xx)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status, uri) (rate(http_server_requests_seconds_count{service=\"$service\", uri!~\"/actuator.*\", outcome=\"CLIENT_ERROR\"}[$__rate_interval]))",
          "legendFormat": "{{status}} {{uri}}",
          "datasource": {
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "Duration",
      "collapsed": false,
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "p99 by endpoint",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{service=\"$service\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}}",
          "datasource": {
            "uid": "prometheus"
          },
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
